# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Storybook — regenerated by the withStorybook Metro plugin from
# .rnstorybook/main.ts every time Metro starts.
.rnstorybook/storybook.requires.ts

# Storybook — regenerated by scripts/write-story-manifest.js (see
# metro.config.js) every time Metro starts.
.rnstorybook/generated/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# generated registry — .github/workflows/deploy-registry.yml rebuilds this
# from src/ on every deploy, so a committed copy would just go stale
/docs/r/

# generated Storybook web export (`npm run build:web`, i.e.
# `expo export --platform web`) — same workflow copies `dist/`'s output
# here on every deploy, so this would go stale the same way /docs/r/ would
/docs/_expo/
/docs/assets/
/docs/index.html
/docs/metadata.json
/docs/favicon.ico
